/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Preprocess profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Entry point for atlas-build preprocess runs. The pipeline performs loading,
    quality control, optional ambient correction and doublet detection, per-cell
    annotation, sample merging, integration, dimensionality reduction and clustering,
    then stops before the per-group downstream analyses (DE, LIANA, cell2cell).

    Use with a software profile and a samplesheet, for example:

        nextflow run nf-core/scdownstream -profile docker,preprocess --input samplesheet.csv --outdir results

    The resulting finalised AnnData object is published under 09_finalized/ and can be
    fed back into the pipeline with -profile downstream --curated_h5ad <finalised.h5ad>.
*/

params {
    config_profile_name        = 'Preprocess'
    config_profile_description = 'Preprocess entry point: stop after annotation before per-group downstream analyses'

    // Stop before the per-group analyses (DE, LIANA, cell2cell, cluster annotation)
    stop_after_annotation      = true

    // Publish a review bundle with the finalised object, per-annotator label tables and UMAP plots
    review_bundle              = true

    // Reuse the curated object for cellxgene visualisation
    prep_cellxgene             = true
}
