/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Downstream profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Entry point for downstream-only runs starting from an already curated AnnData
    object (for example the finalised object produced by -profile preprocess).

        nextflow run nf-core/scdownstream -profile docker,downstream \
            --curated_h5ad <curated.h5ad> \
            --base_embeddings scvi \
            --base_label_col cell_type \
            --outdir results

    The curated object is expected to already contain the embeddings listed in
    --base_embeddings and the label column given by --base_label_col. Quality control,
    ambient correction, doublet detection, per-cell annotation and integration are all
    skipped; the pipeline runs dimensionality reduction, clustering and the per-group
    downstream analyses (DE, LIANA, optional cell2cell) followed by finalisation.

    Requires --curated_h5ad and --base_embeddings (or --integrate_per_label).
*/

params {
    config_profile_name        = 'Downstream'
    config_profile_description = 'Downstream-only entry point from an already curated AnnData object'

    // The curated object already carries cell type labels
    base_label_col             = 'cell_type'

    // Publish a review bundle with the finalised object, per-annotator label tables and UMAP plots
    review_bundle              = true

    // Reuse the curated object for cellxgene visualisation
    prep_cellxgene             = true
}
