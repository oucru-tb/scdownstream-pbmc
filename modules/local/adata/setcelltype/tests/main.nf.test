nextflow_process {

    name "Test Process ADATA_SETCELLTYPE"
    script "modules/local/adata/setcelltype/main.nf"
    process "ADATA_SETCELLTYPE"

    tag "modules"
    tag "modules_local"

    test("Should set cell_type from the first present source column") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "nonexistent annotation:celltypist:test:per_cell"
                input[2] = "cell_type"
                """
            }
        }

        then {
            def adata = anndata(process.out.h5ad[0][1])
            assert process.success
            assert snapshot(
                process.out,
                path(process.out.versions[0]).yaml,
                adata.yaml
            ).match()
        }

    }

    test("Should set cell_type from the first present source column - stub") {

        options '-stub'

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "nonexistent annotation:celltypist:test:per_cell"
                input[2] = "cell_type"
                """
            }
        }

        then {
            assert process.success

            assert snapshot(process.out).match()
        }

    }

    test("Should fail when no source column is present") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of([
                        [ id: 'test' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/scrnaseq/h5ad/SRR28679756_filtered_matrix.h5ad', checkIfExists: true)
                    ]
                )
                input[1] = "nonexistent_a nonexistent_b"
                input[2] = "cell_type"
                """
            }
        }

        then {
            assert process.failed
            assert process.errorReport.contains("were found in obs")
        }

    }

}
